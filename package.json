{
  "name": "prompt-compiler-engine",
  "version": "2.0.0",
  "description": "Universal Prompt Compiler - Chrome Extension with 6-Stage Rule-Based Pipeline",
  "author": "Rushi Gulum",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build:ext": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --dev",
    "validate:extension-manifest": "node scripts/validate-extension-manifest.mjs src/extension/manifest.json",
    "package": "npm run build:ext && cd dist && tar -cf ../extension.tar .",
    "package:zip": "npm run build:ext && node scripts/create-dist-zip.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ext.json --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
